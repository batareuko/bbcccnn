DATABASE_URL="file:./dev.db"
# Public URL of the site (canonical links, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret for the /api/cron endpoint (Vercel Cron / external scheduler): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── AI (rewrite + content plan) ──
# gemini (default) | deepseek | anthropic
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
