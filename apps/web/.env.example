DATABASE_URL="file:./dev.db"
# Public URL of the site (canonical links, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret for the /api/cron endpoint (Vercel Cron / external scheduler): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── AI (rewrite + content plan) ──
# gemini (default) | deepseek | anthropic
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Billing: WayForPay (Ukrainian cards, UAH) ──
# Merchant → Settings in the WayForPay dashboard. serviceUrl/returnUrl are sent automatically:
#   {NEXT_PUBLIC_SITE_URL}/api/billing/wayforpay/callback and /api/billing/wayforpay/return
WAYFORPAY_MERCHANT_ACCOUNT=""
WAYFORPAY_SECRET_KEY=""
# Needed to cancel subscriptions and reconcile renewals via the regular payments API
WAYFORPAY_MERCHANT_PASSWORD=""
# Domain registered in WayForPay (defaults to the host of NEXT_PUBLIC_SITE_URL)
WAYFORPAY_DOMAIN=""

# ── Billing: Paddle (international, USD; merchant of record) ──
# sandbox | production
PADDLE_ENV="sandbox"
# Developer tools → Authentication: client-side token (starts with test_ / live_) and API key
PADDLE_CLIENT_TOKEN=""
PADDLE_API_KEY=""
# Developer tools → Notifications: destination {NEXT_PUBLIC_SITE_URL}/api/billing/paddle/webhook,
# events: transaction.completed, subscription.created, subscription.updated, subscription.canceled, subscription.past_due
PADDLE_WEBHOOK_SECRET=""
# Catalog → Products: create the prices and paste their ids (pri_...)
PADDLE_PRICE_STARTER_MONTH=""
PADDLE_PRICE_STARTER_YEAR=""
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""
PADDLE_PRICE_AGENCY_MONTH=""
PADDLE_PRICE_AGENCY_YEAR=""
PADDLE_PRICE_CREDITS_100=""

# ── Business details (legal pages, footer). Required by WayForPay, Paddle and Meta review ──
LEGAL_NAME="ФОП Прізвище Ім'я По батькові"
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_EMAIL="support@your-domain.com"
LEGAL_PHONE=""

# ── Shared Telegram bot (create with @BotFather) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""   # without @
# random string [A-Za-z0-9_-]; then run: npm run telegram setup
TELEGRAM_WEBHOOK_SECRET=""

# ── Moderation ──
# comma-separated words/phrases that flag a post for review (case-insensitive)
MODERATION_KEYWORDS=""
# true = flagged scheduled posts wait for moderator approval in /admin/content
MODERATION_HOLD="false"
